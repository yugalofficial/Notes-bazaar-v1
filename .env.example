# ==============================================================================
# NotesBazaar Environment Variables Template (NEVER commit actual secrets!)
# ==============================================================================

# Server Configuration
PORT=3000
APP_URL=http://localhost:3000

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Razorpay Payment Gateway (SERVER-SIDE SECRETS + PUBLIC KEY ID)
# Keep RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET strictly on the server!
RAZORPAY_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=

# Secondary Gateways & Delivery Integrations
VITE_PAYPAL_CLIENT_ID=
VITE_APPSCRIPT_DELIVERY_WEBHOOK=

# EmailJS (Secondary Backup)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
